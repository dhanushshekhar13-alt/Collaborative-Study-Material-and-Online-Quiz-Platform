# Copy to .env and fill in real values. .env is git-ignored; never commit secrets.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./study_platform.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM provider settings. Leave LLM_PROVIDER=none to run without an LLM.
# Supported providers: anthropic, openai (LLM_MODEL is that provider's model name).
# Without an LLM, descriptive answers are scored by deterministic concept matching.
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=

# Comma-separated browser origins allowed to call the API, e.g. http://localhost:5173
CORS_ORIGINS=

# Largest study material upload accepted, in MB.
MATERIAL_MAX_UPLOAD_MB=20

# Submitting a quiz with unanswered questions: "warn" (confirm first) or "block".
QUIZ_UNANSWERED_RULE=warn
